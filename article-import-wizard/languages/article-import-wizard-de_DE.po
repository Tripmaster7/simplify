#: templates/wizard-step-upload.php
msgid "Help"
msgstr "Hilfe"

#: templates/wizard-step-upload.php
msgid "Open Draft"
msgstr "Entwurf öffnen"

#: templates/wizard-step-upload.php
msgid "Preview Before Draft Creation"
msgstr "Vorschau vor Entwurfserstellung"

#: templates/wizard-step-upload.php
msgid "Review this generated article. If everything looks good, create the draft."
msgstr "Prüfen Sie den erzeugten Artikel. Wenn alles passt, erstellen Sie den Entwurf."

#: templates/wizard-step-upload.php
msgid "Membership Number"
msgstr "Mitgliedsnummer"

#: templates/wizard-step-upload.php
msgid "Resolved Public Author"
msgstr "Öffentlich sichtbarer Autor"

#: templates/wizard-step-upload.php
msgid "Categories"
msgstr "Kategorien"

#: templates/wizard-step-upload.php
msgid "None"
msgstr "Keine"

#: templates/wizard-step-upload.php
msgid "Title"
msgstr "Titel"

#: templates/wizard-step-upload.php
msgid "Source Document"
msgstr "Quelldokument"

#: templates/wizard-step-upload.php
msgid "Author Bio for Profile"
msgstr "Autoren-Bio für das Profil"

#: templates/wizard-step-upload.php
msgid "No bio provided."
msgstr "Keine Bio angegeben."

#: templates/wizard-step-upload.php
msgid "Validation"
msgstr "Validierung"

#: templates/wizard-step-upload.php
msgid "Invalid Links:"
msgstr "Ungültige Links:"

#: templates/wizard-step-upload.php
msgid "Missing Image Slots:"
msgstr "Fehlende Bildslots:"

#: templates/wizard-step-upload.php
msgid "Metadata Warnings:"
msgstr "Metadaten-Warnungen:"

#: templates/wizard-step-upload.php
msgid "Generated Content Preview"
msgstr "Vorschau des erzeugten Inhalts"

#: templates/wizard-step-upload.php
msgid "Create Draft From Preview"
msgstr "Entwurf aus Vorschau erstellen"

#: templates/wizard-step-upload.php
msgid "Start New Import"
msgstr "Neuen Import starten"

#: templates/wizard-step-upload.php
msgid "Guided Article Import"
msgstr "Geführter Artikel-Import"

#: templates/wizard-step-upload.php
msgid "Upload a DOCX file or provide content manually. Public attribution always uses the membership number user account."
msgstr "Laden Sie eine DOCX-Datei hoch oder geben Sie Inhalte manuell ein. Die öffentliche Autorenzuordnung nutzt immer das Benutzerkonto der Mitgliedsnummer."

#: templates/wizard-step-upload.php
msgid "Inserted at the [RESTRICT] anchor inside the article."
msgstr "Wird am [RESTRICT]-Anker im Artikel eingefügt."

#: templates/wizard-step-upload.php
msgid "Inserted after the article body and before the author bio."
msgstr "Wird nach dem Artikeltext und vor der Autoren-Bio eingefügt."

#: templates/wizard-step-upload.php
msgid "Must match the author username exactly."
msgstr "Muss exakt dem Autoren-Benutzernamen entsprechen."

#: templates/wizard-step-upload.php
msgid "Select at least one category. Multiple categories are allowed."
msgstr "Wählen Sie mindestens eine Kategorie. Mehrfachauswahl ist möglich."

#: templates/wizard-step-upload.php
msgid "New Category"
msgstr "Neue Kategorie"

#: templates/wizard-step-upload.php
msgid "Article Title"
msgstr "Artikeltitel"

#: templates/wizard-step-upload.php
msgid "Optional if title is available in DOCX."
msgstr "Optional, wenn der Titel in der DOCX enthalten ist."

#: templates/wizard-step-upload.php
msgid "DOCX File"
msgstr "DOCX-Datei"

#: templates/wizard-step-upload.php
msgid "DOCX is parsed for title/content/placeholders."
msgstr "Die DOCX wird auf Titel/Inhalt/Platzhalter analysiert."

#: templates/wizard-step-upload.php
msgid "Article Content"
msgstr "Artikelinhalt"

#: templates/wizard-step-upload.php
msgid "Optional if content is available in DOCX."
msgstr "Optional, wenn der Inhalt in der DOCX enthalten ist."

#: templates/wizard-step-upload.php
msgid "Headline Picture"
msgstr "Aufmacherbild"

#: templates/wizard-step-upload.php
msgid "Inline Picture Count"
msgstr "Anzahl Inline-Bilder"

#: templates/wizard-step-upload.php
msgid "Upload images in order. They replace [Bild 1], [Bild 2], ... markers."
msgstr "Bilder in der Reihenfolge hochladen. Sie ersetzen die Marker [Bild 1], [Bild 2], ..."

#: templates/wizard-step-upload.php
msgid "Inline Pictures"
msgstr "Inline-Bilder"

#: templates/wizard-step-upload.php
msgid "One upload field is generated for each selected picture slot."
msgstr "Für jeden gewählten Bildslot wird ein Upload-Feld erzeugt."

#: templates/wizard-step-upload.php
msgid "Author Bio"
msgstr "Autoren-Bio"

#: templates/wizard-step-upload.php
msgid "Author Bio Picture"
msgstr "Bild zur Autoren-Bio"

#: templates/wizard-step-upload.php
msgid "Restriction shortcodes come from plugin settings and DOCX markers."
msgstr "Restriktions-Shortcodes stammen aus Plugin-Einstellungen und DOCX-Markern."

#: templates/wizard-step-upload.php
msgid "Generate Preview"
msgstr "Vorschau erzeugen"

#: templates/wizard-step-upload.php
msgid "Picture Slot"
msgstr "Bildslot"

#: templates/wizard-step-upload.php
msgid "Enter new category name"
msgstr "Neuen Kategorienamen eingeben"

#: includes/class-aiw-wizard-controller.php
msgid "You do not have permission to access this page."
msgstr "Sie haben keine Berechtigung, auf diese Seite zuzugreifen."

#: includes/class-aiw-wizard-controller.php
msgid "Unauthorized."
msgstr "Nicht autorisiert."

#: includes/class-aiw-wizard-controller.php
msgid "You do not have permission to create categories."
msgstr "Sie haben keine Berechtigung, Kategorien zu erstellen."

#: includes/class-aiw-wizard-controller.php
msgid "Membership number is required."
msgstr "Mitgliedsnummer ist erforderlich."

#: includes/class-aiw-wizard-controller.php
msgid "Please select at least one category."
msgstr "Bitte wählen Sie mindestens eine Kategorie aus."

#: includes/class-aiw-wizard-controller.php
msgid "No user found for that membership number."
msgstr "Für diese Mitgliedsnummer wurde kein Benutzer gefunden."

#: includes/class-aiw-wizard-controller.php
msgid "DOCX membership number does not match the wizard membership number."
msgstr "Die DOCX-Mitgliedsnummer stimmt nicht mit der im Assistenten überein."

#: includes/class-aiw-wizard-controller.php
msgid "DOCX is missing the [RESTRICT] anchor."
msgstr "In der DOCX fehlt der [RESTRICT]-Anker."

#: includes/class-aiw-wizard-controller.php
msgid "Title and content are required (either manually or from DOCX)."
msgstr "Titel und Inhalt sind erforderlich (manuell oder aus DOCX)."

#: includes/class-aiw-wizard-controller.php
msgid "Preview generated. Review and confirm draft creation."
msgstr "Vorschau erstellt. Bitte prüfen und Entwurfserstellung bestätigen."

#: includes/class-aiw-wizard-controller.php
msgid "Preview token missing. Please run preview first."
msgstr "Vorschau-Token fehlt. Bitte zuerst Vorschau ausführen."

#: includes/class-aiw-wizard-controller.php
msgid "Preview data expired. Please run preview again."
msgstr "Vorschau-Daten sind abgelaufen. Bitte Vorschau erneut ausführen."

#: includes/class-aiw-wizard-controller.php
msgid "At least one category is required. Please generate preview again."
msgstr "Mindestens eine Kategorie ist erforderlich. Bitte Vorschau erneut erzeugen."

#: includes/class-aiw-wizard-controller.php
msgid "Attributed author is missing in preview payload."
msgstr "Zugeordneter Autor fehlt in den Vorschau-Daten."

#: includes/class-aiw-wizard-controller.php
msgid "Draft #%1$s created. Attributed author: %2$s"
msgstr "Entwurf #%1$s erstellt. Zugeordneter Autor: %2$s"
