msgstr "Titel"

#: templates/wizard-step-upload.php
msgid "Source Document"
msgstr "Quelldokument"

#: templates/wizard-step-upload.php
msgid "Author Bio for Profile"
msgstr "Autoren-Bio für das Profil"

#: templates/wizard-step-upload.php
msgid "No bio provided."
msgstr "Keine Bio angegeben."

#: templates/wizard-step-upload.php
msgid "Validation"
msgstr "Validierung"

#: templates/wizard-step-upload.php
msgid "Invalid Links:"
msgstr "Ungültige Links:"

#: templates/wizard-step-upload.php
msgid "Missing Image Slots:"
msgstr "Fehlende Bildslots:"

#: templates/wizard-step-upload.php
msgid "Metadata Warnings:"
msgstr "Metadaten-Warnungen:"

#: templates/wizard-step-upload.php
msgid "Generated Content Preview"
msgstr "Vorschau des erzeugten Inhalts"

#: templates/wizard-step-upload.php
msgid "Create Draft From Preview"
msgstr "Entwurf aus Vorschau erstellen"

#: templates/wizard-step-upload.php
msgid "Start New Import"
msgstr "Neuen Import starten"

#: templates/wizard-step-upload.php
msgid "Guided Article Import"
msgstr "Geführter Artikel-Import"

#: templates/wizard-step-upload.php
msgid "Upload a DOCX file or provide content manually. Public attribution always uses the membership number user account."
msgstr "Laden Sie eine DOCX-Datei hoch oder geben Sie Inhalte manuell ein. Die öffentliche Autorenzuordnung nutzt immer das Benutzerkonto der Mitgliedsnummer."

#: templates/wizard-step-upload.php
msgid "Inserted at the [RESTRICT] anchor inside the article."
msgstr "Wird am [RESTRICT]-Anker im Artikel eingefügt."

#: templates/wizard-step-upload.php
msgid "Inserted after the article body and before the author bio."
msgstr "Wird nach dem Artikeltext und vor der Autoren-Bio eingefügt."

#: templates/wizard-step-upload.php
msgid "Must match the author username exactly."
msgstr "Muss exakt dem Autoren-Benutzernamen entsprechen."

#: templates/wizard-step-upload.php
msgid "Select at least one category. Multiple categories are allowed."
msgstr "Wählen Sie mindestens eine Kategorie. Mehrfachauswahl ist möglich."

#: templates/wizard-step-upload.php
msgid "New Category"
msgstr "Neue Kategorie"

#: templates/wizard-step-upload.php
msgid "Article Title"
msgstr "Artikeltitel"

#: templates/wizard-step-upload.php
msgid "Optional if title is available in DOCX."
msgstr "Optional, wenn der Titel in der DOCX enthalten ist."

#: templates/wizard-step-upload.php
msgid "DOCX File"
msgstr "DOCX-Datei"

#: templates/wizard-step-upload.php
msgid "DOCX is parsed for title/content/placeholders."
msgstr "Die DOCX wird auf Titel/Inhalt/Platzhalter analysiert."

#: templates/wizard-step-upload.php
msgid "Article Content"
msgstr "Artikelinhalt"

#: templates/wizard-step-upload.php
msgid "Optional if content is available in DOCX."
msgstr "Optional, wenn der Inhalt in der DOCX enthalten ist."

#: templates/wizard-step-upload.php
msgid "Headline Picture"
msgstr "Aufmacherbild"

#: templates/wizard-step-upload.php
msgid "Inline Picture Count"
msgstr "Anzahl Inline-Bilder"

#: templates/wizard-step-upload.php
msgid "Upload images in order. They replace [Bild 1], [Bild 2], ... markers."
msgstr "Bilder in der Reihenfolge hochladen. Sie ersetzen die Marker [Bild 1], [Bild 2], ..."

#: templates/wizard-step-upload.php
msgid "Inline Pictures"
msgstr "Inline-Bilder"

#: templates/wizard-step-upload.php
msgid "One upload field is generated for each selected picture slot."
msgstr "Für jeden gewählten Bildslot wird ein Upload-Feld erzeugt."

#: templates/wizard-step-upload.php
msgid "Author Bio"
msgstr "Autoren-Bio"

#: templates/wizard-step-upload.php
msgid "Author Bio Picture"
msgstr "Bild zur Autoren-Bio"

#: templates/wizard-step-upload.php
msgid "Restriction shortcodes come from plugin settings and DOCX markers."
msgstr "Restriktions-Shortcodes stammen aus Plugin-Einstellungen und DOCX-Markern."

#: templates/wizard-step-upload.php
msgid "Generate Preview"
msgstr "Vorschau erzeugen"

#: templates/wizard-step-upload.php
msgid "Picture Slot"
msgstr "Bildslot"

#: templates/wizard-step-upload.php
msgid "Enter new category name"
msgstr "Neuen Kategorienamen eingeben"

#: includes/class-aiw-wizard-controller.php
msgid "You do not have permission to access this page."
msgstr "Sie haben keine Berechtigung, auf diese Seite zuzugreifen."

#: includes/class-aiw-wizard-controller.php
msgid "Unauthorized."
msgstr "Nicht autorisiert."

#: includes/class-aiw-wizard-controller.php
msgid "You do not have permission to create categories."
msgstr "Sie haben keine Berechtigung, Kategorien zu erstellen."

#: includes/class-aiw-wizard-controller.php
msgid "Membership number is required."
msgstr "Mitgliedsnummer ist erforderlich."

#: includes/class-aiw-wizard-controller.php
msgid "Please select at least one category."
msgstr "Bitte wählen Sie mindestens eine Kategorie aus."

#: includes/class-aiw-wizard-controller.php
msgid "No user found for that membership number."
msgstr "Für diese Mitgliedsnummer wurde kein Benutzer gefunden."

#: includes/class-aiw-wizard-controller.php
msgid "DOCX membership number does not match the wizard membership number."
msgstr "Die DOCX-Mitgliedsnummer stimmt nicht mit der im Assistenten überein."

#: includes/class-aiw-wizard-controller.php
msgid "Title and content are required (either manually or from DOCX)."
msgstr "Titel und Inhalt sind erforderlich (manuell oder aus DOCX)."

#: includes/class-aiw-wizard-controller.php
msgid "Preview generated. Review and confirm draft creation."
msgstr "Vorschau erstellt. Bitte prüfen und Entwurfserstellung bestätigen."

#: includes/class-aiw-wizard-controller.php
msgid "Preview token missing. Please run preview first."
msgstr "Vorschau-Token fehlt. Bitte zuerst Vorschau ausführen."

#: includes/class-aiw-wizard-controller.php
msgid "Preview data expired. Please run preview again."
msgstr "Vorschau-Daten sind abgelaufen. Bitte Vorschau erneut ausführen."

#: includes/class-aiw-wizard-controller.php
msgid "At least one category is required. Please generate preview again."
msgstr "Mindestens eine Kategorie ist erforderlich. Bitte Vorschau erneut erzeugen."

#: includes/class-aiw-wizard-controller.php
msgid "Attributed author is missing in preview payload."
msgstr "Zugeordneter Autor fehlt in den Vorschau-Daten."

#: includes/class-aiw-wizard-controller.php
msgid "Draft #%1$s created. Attributed author: %2$s"
msgstr "Entwurf #%1$s erstellt. Zugeordneter Autor: %2$s"

#: includes/class-aiw-wizard-controller.php
#, php-format
msgid "The DOCX contains more than one [%s] marker. The first value was used."
msgstr "Die DOCX enthält mehr als einen [%s]-Marker. Der erste Wert wurde verwendet."

#: includes/class-aiw-wizard-controller.php
#, php-format
msgid "%d link(s) were not checked because the link check took too long. Please check them manually."
msgstr "%d Link(s) wurden nicht geprüft, weil die Link-Prüfung zu lange dauerte. Bitte manuell prüfen."

#: includes/class-aiw-wizard-controller.php
#, php-format
msgid "Image \"%1$s\" could not be uploaded: %2$s"
msgstr "Bild „%1$s“ konnte nicht hochgeladen werden: %2$s"

#: includes/class-aiw-wizard-controller.php
#, php-format
msgid "No [RESTRICT] marker found. The restricted part starts automatically after paragraph %d."
msgstr "Kein [RESTRICT]-Marker gefunden. Der geschützte Teil beginnt automatisch nach Absatz %d."

#: includes/class-aiw-wizard-controller.php
msgid "The restricted part is empty because nothing follows the restriction start. Add a [RESTRICT] marker earlier in the article."
msgstr "Der geschützte Teil ist leer, weil nach dem Restriktionsbeginn nichts mehr folgt. Setzen Sie einen [RESTRICT]-Marker weiter vorne im Artikel."

#: includes/class-aiw-wizard-controller.php
msgid "The restriction start and end shortcodes are required. Please set them under Settings > Article Import Wizard."
msgstr "Die Shortcodes für Beginn und Ende der Restriktion sind erforderlich. Bitte unter Einstellungen > Artikel-Import-Assistent festlegen."

#: includes/class-aiw-settings.php
msgid "The restriction start shortcode is required and must be a shortcode such as [restrict]. The default was restored."
msgstr "Der Shortcode für den Restriktionsbeginn ist erforderlich und muss ein Shortcode wie [restrict] sein. Der Standardwert wurde wiederhergestellt."

#: includes/class-aiw-settings.php
#, php-format
msgid "The restriction end shortcode is required. It was set to %s to match the start shortcode."
msgstr "Der Shortcode für das Restriktionsende ist erforderlich. Er wurde passend zum Beginn auf %s gesetzt."

#: includes/class-aiw-settings.php
msgid "Required. Inserted at the [RESTRICT] marker, or automatically after the 2nd paragraph (earlier if the first paragraph reaches 1,000 characters)."
msgstr "Erforderlich. Wird am [RESTRICT]-Marker eingefügt, sonst automatisch nach dem 2. Absatz (früher, wenn der erste Absatz 1.000 Zeichen erreicht)."

#: includes/class-aiw-settings.php
msgid "Required. Always inserted after the last paragraph, before the author bio, so the bio stays public."
msgstr "Erforderlich. Wird immer nach dem letzten Absatz und vor der Autoren-Bio eingefügt, damit die Bio öffentlich bleibt."

#: includes/class-aiw-wizard-controller.php
#, php-format
msgid "[WRITING_DATE: %s] is not a valid date, so the post date was not set. Use the format 2025-01-15 or 15.01.2025."
msgstr "[WRITING_DATE: %s] ist kein gültiges Datum, daher wurde das Beitragsdatum nicht gesetzt. Verwenden Sie das Format 2025-01-15 oder 15.01.2025."

#: includes/class-aiw-wizard-controller.php
#, php-format
msgid "The writing date %s is in the future. Publishing the draft will schedule it for that date."
msgstr "Das Schreibdatum %s liegt in der Zukunft. Beim Veröffentlichen wird der Entwurf für dieses Datum geplant."

#: templates/wizard-step-upload.php
msgid "Post Date"
msgstr "Beitragsdatum"

#: templates/wizard-step-upload.php
msgid "from [WRITING_DATE]"
msgstr "aus [WRITING_DATE]"

#: templates/wizard-step-upload.php
msgid "Not set. The publish date will be used."
msgstr "Nicht gesetzt. Es wird das Veröffentlichungsdatum verwendet."

#: includes/class-aiw-wizard-controller.php
msgid "The [BIO: marker is not closed with \"]\". The bio was not imported and its text was kept in the article. Add \"]\" at the end of the bio."
msgstr "Der [BIO:-Marker ist nicht mit „]“ geschlossen. Die Bio wurde nicht übernommen und ihr Text blieb im Artikel. Setzen Sie „]“ an das Ende der Bio."

#, php-format
msgid "%1$d imported articles have this title and author. The most recently changed one (#%2$d) will be updated."
msgstr "%1$d importierte Artikel haben diesen Titel und Autor. Der zuletzt geänderte (#%2$d) wird aktualisiert."

msgid "An existing article was updated by a new import. The previous version is kept as a revision."
msgstr "Ein bestehender Artikel wurde durch einen neuen Import aktualisiert. Die vorherige Version bleibt als Revision erhalten."

#, php-format
msgid "Article #%1$d (%2$s):"
msgstr "Artikel #%1$d (%2$s):"

#, php-format
msgid "Article #%1$s updated. Attributed author: %2$s"
msgstr "Artikel #%1$s aktualisiert. Zugeordneter Autor: %2$s"

#, php-format
msgid "Article Import Completed: %s"
msgstr "Artikel-Import abgeschlossen: %s"

#, php-format
msgid "Article Updated by Import: %s"
msgstr "Artikel durch Import aktualisiert: %s"

#, php-format
msgid "Attributed Author: %s"
msgstr "Zugeordneter Autor: %s"

msgid "Author:"
msgstr "Autor:"

msgid "Checking membership number..."
msgstr "Mitgliedsnummer wird geprüft ..."

msgid "Could not open DOCX file."
msgstr "Die DOCX-Datei konnte nicht geöffnet werden."

msgid "Create as a new article instead (the existing article stays unchanged)"
msgstr "Stattdessen als neuen Artikel anlegen (der bestehende Artikel bleibt unverändert)"

msgid "DOCX document content is missing."
msgstr "Der Inhalt des DOCX-Dokuments fehlt."

#, php-format
msgid "Edit URL: %s"
msgstr "Bearbeiten: %s"

msgid "Enter a valid five-digit membership number starting with 0."
msgstr "Geben Sie eine gültige fünfstellige Mitgliedsnummer ein, die mit 0 beginnt."

msgid "Enter five digits starting with 0."
msgstr "Geben Sie fünf Ziffern ein, beginnend mit 0."

msgid "Flag only"
msgstr "Nur markieren"

#, php-format
msgid "Imported By (Internal User ID): %d"
msgstr "Importiert von (interne Benutzer-ID): %d"

#, php-format
msgid "Invalid Links: %d"
msgstr "Ungültige Links: %d"

#, php-format
msgid "Membership Number: %s"
msgstr "Mitgliedsnummer: %s"

msgid "No author found for that membership number."
msgstr "Für diese Mitgliedsnummer wurde kein Autor gefunden."

msgid "Only DOCX files are allowed."
msgstr "Es sind nur DOCX-Dateien erlaubt."

msgid "Optionally select the date of the travel."
msgstr "Wählen Sie optional das Datum der Reise aus."

#, php-format
msgid "Picture slots without a new upload keep their previous picture: %s"
msgstr "Bildslots ohne neuen Upload behalten ihr bisheriges Bild: %s"

msgid "Please select a valid travel date."
msgstr "Bitte wählen Sie ein gültiges Reisedatum aus."

#, php-format
msgid "Post ID: %d"
msgstr "Beitrags-ID: %d"

msgid "Preview generated. This upload updates an existing article. Review and confirm the update."
msgstr "Vorschau erstellt. Dieser Upload aktualisiert einen bestehenden Artikel. Bitte prüfen und die Aktualisierung bestätigen."

msgid "The article could not be saved."
msgstr "Der Artikel konnte nicht gespeichert werden."

msgid "The article import process has completed."
msgstr "Der Artikel-Import ist abgeschlossen."

msgid "The article to update is no longer available or you may not edit it. Please generate the preview again."
msgstr "Der zu aktualisierende Artikel ist nicht mehr verfügbar oder Sie dürfen ihn nicht bearbeiten. Bitte erzeugen Sie die Vorschau erneut."

#, php-format
msgid "The article was edited in WordPress on %s, after its last import. Those edits will be overwritten; they stay available as a revision."
msgstr "Der Artikel wurde am %s nach seinem letzten Import in WordPress bearbeitet. Diese Änderungen werden überschrieben; sie bleiben als Revision erhalten."

msgid "The membership number could not be checked. Please try again."
msgstr "Die Mitgliedsnummer konnte nicht geprüft werden. Bitte versuchen Sie es erneut."

msgid "The text, pictures, categories and bio are replaced by this upload. Title, author and status stay unchanged."
msgstr "Text, Bilder, Kategorien und Bio werden durch diesen Upload ersetzt. Titel, Autor und Status bleiben unverändert."

msgid "This article is published. Confirming changes it live; the previous version is kept as a revision."
msgstr "Dieser Artikel ist veröffentlicht. Die Bestätigung ändert ihn sofort; die vorherige Version bleibt als Revision erhalten."

#, php-format
msgid "This upload matches the existing article #%1$d \"%2$s\", which you are not allowed to edit. Please ask an editor to import the update."
msgstr "Dieser Upload passt zum bestehenden Artikel #%1$d „%2$s“, den Sie nicht bearbeiten dürfen. Bitte lassen Sie die Aktualisierung von jemandem mit Bearbeitungsrechten importieren."

msgid "This upload updates an existing article."
msgstr "Dieser Upload aktualisiert einen bestehenden Artikel."

#, php-format
msgid "Title: %s"
msgstr "Titel: %s"

msgid "Travel Date"
msgstr "Reisedatum"

msgid "Update Article"
msgstr "Artikel aktualisieren"

msgid "Update Published Article"
msgstr "Veröffentlichten Artikel aktualisieren"

msgid "Uploaded DOCX temp file is missing."
msgstr "Die hochgeladene temporäre DOCX-Datei fehlt."

msgid "Uploaded DOCX temp file is not accessible."
msgstr "Auf die hochgeladene temporäre DOCX-Datei kann nicht zugegriffen werden."

msgid "ZipArchive is not available on this server."
msgstr "ZipArchive ist auf diesem Server nicht verfügbar."

msgid "Page Navigation"
msgstr "Seiten-Navigation"

msgid "Back Link on Sub-Pages"
msgstr "Rücklink auf Unterseiten"

msgid "No pages with sub-pages found."
msgstr "Keine Seiten mit Unterseiten gefunden."

msgid "Sub-pages of the selected pages show a link back to them at the top and bottom, for example the chapters of a guide linking back to its table of contents."
msgstr "Unterseiten der ausgewählten Seiten zeigen oben und unten einen Link zurück zu ihnen, zum Beispiel die Kapitel eines Ratgebers mit einem Link zurück zum Inhaltsverzeichnis."

#. translators: %s: title of the overview (parent) page
#, php-format
msgid "Back to overview: %s"
msgstr "Zurück zur Übersicht: %s"
